@model GroupOneFlight.Areas.Airlines.Models.Flight
@using GroupOneFlight.Areas.Airlines.Models
@{
    ViewData["Title"] = "Flight Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isSelected = (bool)(ViewBag.IsSelected ?? false);
    int  selCount   = (int)(ViewBag.SelectionCount ?? 0);
}

<div class="container mt-4 mb-5">
    <div class="d-flex align-items-center mb-4">
        <i class="fas fa-plane fs-3 text-primary me-2"></i>
        <h2 class="mb-0">Flight Details</h2>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    @if (Model.Airline != null && !string.IsNullOrEmpty(Model.Airline.ImageName))
                    {
                        <img src="~/images/@Model.Airline.ImageName" alt="@Model.Airline.Name"
                             style="height:36px; object-fit:contain;" />
                    }
                    <div>
                        <span class="fw-bold fs-5">@Model.FlightNumber</span>
                        @if (Model.Airline != null)
                        {
                            <span class="text-white-50 ms-2 small">@Model.Airline.Name</span>
                        }
                    </div>
                </div>
                <span class="badge bg-light text-dark fs-6">@Model.CabinType</span>
            </div>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">From</p>
                    <p class="fw-semibold fs-5 mb-0">@Model.From</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">To</p>
                    <p class="fw-semibold fs-5 mb-0">@Model.To</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted small mb-1">Date</p>
                    <p class="mb-0">@Model.Date.ToString("MMM dd, yyyy")</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted small mb-1">Departure</p>
                    <p class="mb-0">@(Model.DepartureTime ?? "—")</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted small mb-1">Arrival</p>
                    <p class="mb-0">@(Model.ArrivalTime ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">Aircraft Type</p>
                    <p class="mb-0">@(Model.AircraftType ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">Cabin Type</p>
                    <p class="mb-0">@Model.CabinType</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">CO2 Emission</p>
                    <p class="mb-0">@Model.Emission kg</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">Price</p>
                    <p class="fw-bold fs-4 text-success mb-0">$@Model.Price.ToString("0.00")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 align-items-center">
        <a asp-controller="Search" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Search
        </a>

        @if (isSelected)
        {
            <button class="btn btn-success" disabled>
                <i class="fas fa-check me-1"></i> Already Selected
            </button>
            <a asp-controller="Search" asp-action="Selections" class="btn btn-outline-primary">
                <i class="fas fa-suitcase me-1"></i> View Selections
                <span class="badge bg-primary ms-1">@selCount</span>
            </a>
        }
        else
        {
            <form asp-controller="Search" asp-action="Select" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="flightId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-plus-circle me-1"></i> Select This Flight
                </button>
            </form>
        }
    </div>
</div>
