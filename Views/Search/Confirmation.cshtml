@model List<GroupOneFlight.Models.DomainModels.Reservation>
@using GroupOneFlight.Models.DomainModels

@{
    ViewData["Title"] = "Booking Confirmed";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var first = Model.First();
    decimal grandTotal = Model.Sum(r => r.TotalPrice);
}

<div class="container mt-4 mb-5">

    <!-- Success Banner -->
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
        <i class="fas fa-check-circle fa-2x me-3"></i>
        <div>
            <h4 class="alert-heading mb-1">Booking Confirmed!</h4>
            <p class="mb-0">
                A confirmation has been reserved under
                <strong>@first.ConfirmationNumber</strong>.
                Save this number for your records.
            </p>
        </div>
    </div>

    <div class="row">

        <!-- Booking Summary -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-receipt me-2"></i>Booking Summary
                        <span class="float-end text-warning">@first.ConfirmationNumber</span>
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>Flight</th>
                                <th>Route</th>
                                <th>Date</th>
                                <th>Departure</th>
                                <th>Cabin</th>
                                <th class="text-end">Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@reservation.Flight?.FlightCode</strong>
                                        <div class="text-muted small">@reservation.Flight?.Airline?.Name</div>
                                    </td>
                                    <td>
                                        @reservation.Flight?.From
                                        <span class="text-muted">→</span>
                                        @reservation.Flight?.To
                                    </td>
                                    <td>@reservation.Flight?.Date.ToString("MMM dd, yyyy")</td>
                                    <td>@(reservation.Flight?.DepartureTime ?? "—")</td>
                                    <td>
                                        <span class="badge bg-secondary">@reservation.CabinType</span>
                                    </td>
                                    <td class="text-end text-success fw-bold">
                                        $@reservation.TotalPrice.ToString("0.00")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end fw-semibold">Grand Total (@first.PassengerCount passenger@(first.PassengerCount > 1 ? "s" : ""))</td>
                                <td class="text-end text-success fw-bold fs-5">$@grandTotal.ToString("0.00")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Passenger Details -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Passenger</h5>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <span class="text-muted small">Name</span>
                        <div class="fw-semibold">@first.PassengerName</div>
                    </li>
                    <li class="list-group-item">
                        <span class="text-muted small">Email</span>
                        <div>@first.Email</div>
                    </li>
                    <li class="list-group-item">
                        <span class="text-muted small">Passengers</span>
                        <div>@first.PassengerCount</div>
                    </li>
                    <li class="list-group-item">
                        <span class="text-muted small">Booked On</span>
                        <div>@first.BookingDate.ToString("MMM dd, yyyy h:mm tt")</div>
                    </li>
                </ul>
            </div>

            <a asp-controller="Search" asp-action="Index" class="btn btn-outline-primary w-100">
                <i class="fas fa-search me-1"></i> Search More Flights
            </a>
        </div>

    </div>
</div>
