@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
    <div class="container-fluid">
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active fw-bold" : "text-dark")"
                       asp-area="Admin" asp-controller="Users" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Manage" ? "active fw-bold" : "text-dark")"
                       asp-area="Admin" asp-controller="Users" asp-action="Manage">Manage</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Rights" ? "active fw-bold" : "text-dark")"
                       asp-area="Admin" asp-controller="Users" asp-action="Rights">Rights &amp; Obligations</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">View Site</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

@RenderBody()
