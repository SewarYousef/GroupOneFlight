@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
    <div class="container-fluid">
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active fw-bold" : "text-dark")"
                       asp-area="Client" asp-controller="Client" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Search" ? "active fw-bold" : "text-dark")"
                       asp-area="Client" asp-controller="Client" asp-action="Search">Search</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active fw-bold" : "text-dark")"
   asp-area="Client" asp-controller="Client" asp-action="Privacy">Privacy</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="Admin" asp-controller="Users" asp-action="Index">Admin</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="Airline" asp-controller="Airline" asp-action="Index">Airline</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

@RenderBody()
