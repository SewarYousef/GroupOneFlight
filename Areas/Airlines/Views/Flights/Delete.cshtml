@model GroupOneFlight.Models.ViewModels.DetailFlightViewModel
@using GroupOneFlight.Models.DomainModels
@using GroupOneFlight.Models.ViewModels

@{
    Layout = "~/Areas/Airlines/Views/Shared/_AirlineLayout.cshtml";
    ViewData["Title"] = "Delete Flight";
}

<div class="container py-5">
    <h2 class="text-danger">Delete Flight</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">

            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this flight?
            </div>

            @if ((bool)(ViewBag.HasReservations ?? false))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-ban me-1"></i>
                    <strong>Cannot Delete:</strong> This flight has <strong>@ViewBag.ReservationCount active reservation@(ViewBag.ReservationCount == 1 ? "" : "s")</strong>
                    and cannot be removed. Cancel the reservations first.
                </div>
            }

            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Flight Details</h5>
                </div>

                <div class="card-body">
                    <dl class="row">

                        <dt class="col-sm-3">Flight Number:</dt>
                        <dd class="col-sm-9">
                            <strong>@(Model.Flight?.FlightCode ?? "N/A")</strong>
                        </dd>

                        <dt class="col-sm-3">Airline:</dt>
                        <dd class="col-sm-9">
                            @(Model.Flight?.Airline?.Name ?? "N/A")
                        </dd>

                        <dt class="col-sm-3">Route:</dt>
                        <dd class="col-sm-9">
                            @(Model.Flight?.From ?? "N/A") → @(Model.Flight?.To ?? "N/A")
                        </dd>

                        <dt class="col-sm-3">Date:</dt>
                        <dd class="col-sm-9">
                            @(Model.Flight?.Date.ToShortDateString() ?? "N/A")
                        </dd>

                        <dt class="col-sm-3">Departure Time:</dt>
                        <dd class="col-sm-9">
                            @(Model.Flight?.DepartureTime ?? "N/A")
                        </dd>

                        <dt class="col-sm-3">Arrival Time:</dt>
                        <dd class="col-sm-9">
                            @(Model.Flight?.ArrivalTime ?? "N/A")
                        </dd>

                        <dt class="col-sm-3">Cabin Type:</dt>
                        <dd class="col-sm-9">
                            @(Model.Flight?.CabinType ?? "N/A")
                        </dd>

                    </dl>
                </div>
            </div>

            <form method="post" action="@Url.Action("Delete", "Flights", new { area = "Airlines", id = Model.Flight?.Id })">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <button type="submit"
                            class="btn btn-danger btn-lg"
                            @((bool)(ViewBag.HasReservations ?? false) ? "disabled" : "")
                            onclick="return confirm('Are you absolutely sure?')">
                        <i class="fas fa-trash"></i> Delete Flight
                    </button>

                    <a href="@Url.Action("Manage", "Flights", new { area = "Airlines" })"
                       class="btn btn-secondary btn-lg">
                        <i class="fas fa-times"></i> Keep Flight
                    </a>
                </div>
            </form>

        </div>

        <div class="col-md-4">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-exclamation-circle"></i> Important
                    </h5>
                    <p class="card-text">
                        Deleting this flight will permanently remove all associated data from the system.
                    </p>
                    <small>This action cannot be reversed.</small>
                </div>
            </div>
        </div>

    </div>
</div>