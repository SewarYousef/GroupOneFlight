@model GroupOneFlight.Areas.Airlines.ViewModels.FlightViewModel
@using GroupOneFlight.Areas.Airlines.Models
@{
    Layout = "~/Areas/Airlines/Views/Shared/_AirlineLayout.cshtml";
    ViewData["Title"] = "Flights";
    bool hasFilter = !string.IsNullOrEmpty(Model.SelectedFrom)
                  || !string.IsNullOrEmpty(Model.SelectedTo)
                  || !string.IsNullOrEmpty(Model.SelectedCabin);
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Filter Flights</h2>
        @if (hasFilter)
        {
            <a asp-area="Airlines" asp-controller="Flights" asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-times me-1"></i> Clear Filters
            </a>
        }
    </div>

    <form method="get" asp-area="Airlines" asp-controller="Flights" asp-action="Index" class="row g-3 mb-4">

        <div class="col-md-4">
            <label class="form-label fw-semibold">From</label>
            <select class="form-select" name="fromCity">
                <option value="">All</option>
                @foreach (var city in Model.FromCities)
                {
                    if (Model.SelectedFrom == city)
                    {
                        <option value="@city" selected="selected">@city</option>
                    }
                    else
                    {
                        <option value="@city">@city</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">To</label>
            <select class="form-select" name="toCity">
                <option value="">All</option>
                @foreach (var city in Model.ToCities)
                {
                    if (Model.SelectedTo == city)
                    {
                        <option value="@city" selected="selected">@city</option>
                    }
                    else
                    {
                        <option value="@city">@city</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">Cabin Type</label>
            <select class="form-select" name="cabinType">
                <option value="">All</option>
                @foreach (var cabin in Model.CabinTypes)
                {
                    if (Model.SelectedCabin == cabin)
                    {
                        <option value="@cabin" selected="selected">@cabin</option>
                    }
                    else
                    {
                        <option value="@cabin">@cabin</option>
                    }
                }
            </select>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-filter me-1"></i> Apply Filters
            </button>
            @if (hasFilter)
            {
                <a asp-area="Airlines" asp-controller="Flights" asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i> Clear Filters
                </a>
            }
        </div>

    </form>

    <hr class="my-3" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            Flights
            @if (hasFilter)
            {
                <span class="badge bg-primary ms-2">@Model.Flights.Count result(s)</span>
            }
        </h4>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Flight #</th>
                    <th>Airline</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Date</th>
                    <th>Departure</th>
                    <th>Arrival</th>
                    <th>Cabin</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Flights != null && Model.Flights.Any())
                {
                    foreach (var flight in Model.Flights)
                    {
                        <tr>
                            <td><strong>@(flight.FlightNumber ?? "N/A")</strong></td>
                            <td>
                                @if (flight.Airline != null && !string.IsNullOrEmpty(flight.Airline.ImageName))
                                {
                                    <img src="~/images/@flight.Airline.ImageName" alt="@flight.Airline.Name"
                                         style="height:24px; object-fit:contain;" class="me-1" />
                                }
                                @(flight.Airline?.Name ?? "N/A")
                            </td>
                            <td>@(flight.From ?? "N/A")</td>
                            <td>@(flight.To ?? "N/A")</td>
                            <td>@flight.Date.ToShortDateString()</td>
                            <td>@(flight.DepartureTime ?? "N/A")</td>
                            <td>@(flight.ArrivalTime ?? "N/A")</td>
                            <td><span class="badge bg-secondary">@(flight.CabinType ?? "N/A")</span></td>
                            <td class="text-success fw-semibold">$@flight.Price.ToString("0.00")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            <i class="fas fa-inbox me-2"></i>
                            @(hasFilter ? "No flights match the selected filters." : "No flights available.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
