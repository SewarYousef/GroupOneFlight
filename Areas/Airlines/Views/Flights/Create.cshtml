@model GroupOneFlight.Areas.Airlines.ViewModels.DetailFlightViewModel
@using GroupOneFlight.Areas.Airlines.Models
@{
    Layout = "~/Areas/Airlines/Views/Shared/_AirlineLayout.cshtml";
    ViewData["Title"] = "Create Flight";
    var today       = DateTime.Today.ToString("yyyy-MM-dd");
    var defaultDate = (Model.Flight != null && Model.Flight.Date > DateTime.MinValue)
                      ? Model.Flight.Date.ToString("yyyy-MM-dd") : today;
}

<div class="container py-5">
    <h2>Create New Flight</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">

            @* Summary validation errors (server-side fallback when JS is off) *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Please fix the following errors:</strong>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @*
                IMPORTANT: The form uses asp-for tag helpers on the inputs so that
                jQuery Unobtrusive Validation can read the data-val-remote-* attributes
                that are generated by the [Remote] attribute on Flight.FlightNumber.
                Without asp-for, the remote validation AJAX call will not fire.
            *@
            <form asp-controller="Flights" asp-action="Create" asp-area="Airlines" method="post">
                @Html.AntiForgeryToken()

                @* ── Flight Number ── *@
                <div class="form-group mb-3">
                    <label asp-for="Flight.FlightNumber" class="form-label">
                        Flight Number <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Flight.FlightNumber"
                           class="form-control"
                           placeholder="e.g., UA123" />
                    @*
                        Sewar: asp-validation-for renders the <span> that jQuery Unobtrusive
                        Validation uses to display the [Remote] error message at property level.
                        This span shows: "This FlightCode + Date combination already exists..."
                    *@
                    <span asp-validation-for="Flight.FlightNumber" class="text-danger small"></span>
                </div>

                @* ── Airline ── *@
                <div class="form-group mb-3">
                    <label class="form-label">Airline <span class="text-danger">*</span></label>
                    <select class="form-select" name="AirlineId" required>
                        <option value="">Select Airline</option>
                        @foreach (var airline in Model.Airlines ?? new List<Airline>())
                        {
                            if (Model.Flight?.AirlineId == airline.Id)
                            {
                                <option value="@airline.Id" selected="selected">@airline.Name</option>
                            }
                            else
                            {
                                <option value="@airline.Id">@airline.Name</option>
                            }
                        }
                    </select>
                </div>

                @* ── From / To ── *@
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.From" class="form-label">
                                From <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Flight.From" class="form-control"
                                   placeholder="e.g., New York" />
                            <span asp-validation-for="Flight.From" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.To" class="form-label">
                                To <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Flight.To" class="form-control"
                                   placeholder="e.g., Los Angeles" />
                            <span asp-validation-for="Flight.To" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                @* ── Date / Cabin Type ── *@
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.Date" class="form-label">
                                Date <span class="text-danger">*</span>
                            </label>
                            @*
                                Sewar: The Date input MUST use asp-for so its name becomes
                                "Flight.Date" — matching the AdditionalFields = "Date" in
                                [Remote]. jQuery will send this value to IsFlightCodeDateUnique.
                                data-validate-date activates Rahul's date-validation.js.
                            *@
                            <input asp-for="Flight.Date"
                                   type="date"
                                   class="form-control"
                                   value="@defaultDate"
                                   min="@today"
                                   data-validate-date />
                            <span asp-validation-for="Flight.Date" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Cabin Type <span class="text-danger">*</span></label>
                            <select class="form-select" name="CabinType" required>
                                <option value="">Select Cabin Type</option>
                                @foreach (var cabin in Model.CabinTypes ?? new List<string>())
                                {
                                    if (Model.Flight?.CabinType == cabin)
                                    {
                                        <option value="@cabin" selected="selected">@cabin</option>
                                    }
                                    else
                                    {
                                        <option value="@cabin">@cabin</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                @* ── Departure / Arrival Time ── *@
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.DepartureTime" class="form-label">
                                Departure Time <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Flight.DepartureTime"
                                   type="time" class="form-control" />
                            <span asp-validation-for="Flight.DepartureTime" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.ArrivalTime" class="form-label">
                                Arrival Time <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Flight.ArrivalTime"
                                   type="time" class="form-control" />
                            <span asp-validation-for="Flight.ArrivalTime" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                @* ── Aircraft Type ── *@
                <div class="form-group mb-3">
                    <label class="form-label">Aircraft Type <span class="text-danger">*</span></label>
                    <select class="form-select" name="AircraftType" required>
                        <option value="">Select Aircraft Type</option>
                        @foreach (var aircraft in Model.AircraftTypes ?? new List<string>())
                        {
                            if (Model.Flight?.AircraftType == aircraft)
                            {
                                <option value="@aircraft" selected="selected">@aircraft</option>
                            }
                            else
                            {
                                <option value="@aircraft">@aircraft</option>
                            }
                        }
                    </select>
                </div>

                @* ── Emission / Price ── *@
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.Emission" class="form-label">
                                CO2 Emission (kg) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Flight.Emission"
                                   type="number" class="form-control"
                                   step="0.01" min="0" placeholder="e.g., 85.50" />
                            <span asp-validation-for="Flight.Emission" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.Price" class="form-label">
                                Price (USD) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Flight.Price"
                                       type="number" class="form-control"
                                       step="0.01" min="0" placeholder="e.g., 299.00" />
                            </div>
                            <span asp-validation-for="Flight.Price" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                @* ── Buttons ── *@
                <div class="form-group mb-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Create Flight
                    </button>
                    <a href="@Url.Action("Manage")" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                </div>

            </form>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-info-circle me-1"></i> Tips</h5>
                    <ul class="small mb-0">
                        <li>Flight code: 2 letters followed by 1–4 digits (e.g., UA123)</li>
                        <li>From/To: letters only, max 50 characters</li>
                        <li>Date must be after today and within 3 years</li>
                        <li>FlightCode + Date must be unique in the system</li>
                        <li>Emission max: 5,000 kg &nbsp;|&nbsp; Price max: $50,000</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @*
        Sewar: jQuery Validation + jQuery Unobtrusive Validation are REQUIRED for
        [Remote] to work on the client side. They intercept form submission, read
        the data-val-remote-* attributes generated by [Remote], and fire the AJAX
        call to IsFlightCodeDateUnique BEFORE the form posts.
        Without these two scripts, remote validation silently does nothing.
    *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    @* Rahul's custom date validation (must come AFTER unobtrusive) *@
    <script src="~/js/date-validation.js" asp-append-version="true"></script>
}
