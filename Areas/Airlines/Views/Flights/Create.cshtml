@model GroupOneFlight.Areas.Airlines.ViewModels.DetailFlightViewModel
@using GroupOneFlight.Areas.Airlines.Models
@{
    Layout = "~/Areas/Airlines/Views/Shared/_AirlineLayout.cshtml";
    ViewData["Title"] = "Create Flight";
    var today       = DateTime.Today.ToString("yyyy-MM-dd");
    var defaultDate = (Model.Flight != null && Model.Flight.Date > DateTime.MinValue)
                      ? Model.Flight.Date.ToString("yyyy-MM-dd") : today;
}

<div class="container py-5">
    <h2>Create New Flight</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-controller="Flights" asp-action="Create" asp-area="Airlines" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <strong>Validation Errors:</strong>
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-group mb-3">
                    <label asp-for="Flight.FlightNumber" class="form-label">Flight Number <span class="text-danger">*</span></label>
                    <input asp-for="Flight.FlightNumber" class="form-control" placeholder="e.g., UA123" />
                    <span asp-validation-for="Flight.FlightNumber" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="AirlineId" class="form-label">Airline <span class="text-danger">*</span></label>
                    <select class="form-select" id="AirlineId" name="AirlineId" required>
                        <option value="">Select Airline</option>
                        @foreach (var airline in Model.Airlines ?? new List<Airline>())
                        {
                            if (Model.Flight?.AirlineId == airline.Id)
                            {
                                <option value="@airline.Id" selected="selected">@airline.Name</option>
                            }
                            else
                            {
                                <option value="@airline.Id">@airline.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.From" class="form-label">From <span class="text-danger">*</span></label>
                            <input asp-for="Flight.From" class="form-control" placeholder="e.g., New York" />
                            <span asp-validation-for="Flight.From" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.To" class="form-label">To <span class="text-danger">*</span></label>
                            <input asp-for="Flight.To" class="form-control" placeholder="e.g., Los Angeles" />
                            <span asp-validation-for="Flight.To" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.Date" class="form-label">Date <span class="text-danger">*</span></label>
                            <input asp-for="Flight.Date" type="date" class="form-control" value="@defaultDate" min="@today" />
                            <span asp-validation-for="Flight.Date" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="CabinType" class="form-label">Cabin Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="CabinType" name="CabinType" required>
                                <option value="">Select Cabin Type</option>
                                @foreach (var cabin in Model.CabinTypes ?? new List<string>())
                                {
                                    if (Model.Flight?.CabinType == cabin)
                                    {
                                        <option value="@cabin" selected="selected">@cabin</option>
                                    }
                                    else
                                    {
                                        <option value="@cabin">@cabin</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.DepartureTime" class="form-label">Departure Time <span class="text-danger">*</span></label>
                            <input asp-for="Flight.DepartureTime" type="time" class="form-control" />
                            <span asp-validation-for="Flight.DepartureTime" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Flight.ArrivalTime" class="form-label">Arrival Time <span class="text-danger">*</span></label>
                            <input asp-for="Flight.ArrivalTime" type="time" class="form-control" />
                            <span asp-validation-for="Flight.ArrivalTime" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="AircraftType" class="form-label">Aircraft Type <span class="text-danger">*</span></label>
                    <select class="form-select" id="AircraftType" name="AircraftType" required>
                        <option value="">Select Aircraft Type</option>
                        @foreach (var aircraft in Model.AircraftTypes ?? new List<string>())
                        {
                            if (Model.Flight?.AircraftType == aircraft)
                            {
                                <option value="@aircraft" selected="selected">@aircraft</option>
                            }
                            else
                            {
                                <option value="@aircraft">@aircraft</option>
                            }
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="Emission" class="form-label">CO2 Emission (kg) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Emission" name="Emission"
                                   step="0.01" min="0" placeholder="e.g., 85.50"
                                   value="@(Model.Flight?.Emission > 0 ? Model.Flight.Emission.ToString("0.00") : "")"
                                   required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="Price" class="form-label">Price (USD) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="Price" name="Price"
                                       step="0.01" min="0" placeholder="e.g., 299.00"
                                       value="@(Model.Flight?.Price > 0 ? Model.Flight.Price.ToString("0.00") : "")"
                                       required />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Create Flight
                    </button>
                    <a href="@Url.Action("Manage")" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                </div>

            </form>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-info-circle me-1"></i> Tips</h5>
                    <ul class="small mb-0">
                        <li>Flight numbers should be unique (e.g., UA123)</li>
                        <li>Date must be after today and within 3 years</li>
                        <li>Ensure departure time is before arrival time</li>
                        <li>Emission is the estimated CO2 in kilograms</li>
                        <li>All fields marked with <span class="text-danger">*</span> are required</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
