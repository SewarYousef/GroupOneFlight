@model GroupOneFlight.Models.ViewModels.FlightFormViewModel
@using GroupOneFlight.Models.DomainModels
@using GroupOneFlight.Models.ViewModels
@{
    Layout = "~/Areas/Airlines/Views/Shared/_AirlineLayout.cshtml";
    ViewData["Title"] = "Edit Flight";
    var tomorrow  = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    var maxDate   = DateTime.Today.AddYears(3).ToString("yyyy-MM-dd");
    var dateValue = (Model.Flight != null && Model.Flight.Date > DateTime.Today)
                    ? Model.Flight.Date.ToString("yyyy-MM-dd") : tomorrow;
}

<div class="container py-5">
    <h2>Edit Flight</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form method="post" action="@Url.Action("Edit", "Flights", new { area = "Airlines", id = Model.Flight?.Id })" onsubmit="return validateAllDates(event)">
                @Html.AntiForgeryToken()
                <!-- Id passed so remote FlightCode+Date check can exclude the current record -->
                <input type="hidden" name="Id" value="@Model.Flight?.Id" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <strong>Validation Errors:</strong>
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <!-- Flight Code: required + remote duplicate check -->
                <div class="form-group mb-3">
                    <label class="form-label">Flight Number <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="FlightCode"
                           placeholder="e.g., UA123"
                           value="@Model.Flight?.FlightCode"
                           data-val="true"
                           data-val-required="Flight Code is required."
                           data-val-remote="This FlightCode + Date combination already exists."
                           data-val-remote-url="/Airlines/Flights/IsFlightCodeDateUnique"
                           data-val-remote-additionalfields="*.Date,*.Id" />
                    <span data-valmsg-for="FlightCode" data-valmsg-replace="true" class="text-danger small"></span>
                </div>

                <!-- Airline -->
                <div class="form-group mb-3">
                    <label class="form-label">Airline <span class="text-danger">*</span></label>
                    <select class="form-select" name="AirlineId"
                            data-val="true"
                            data-val-required="Airline is required."
                            data-val-range="Airline is required."
                            data-val-range-min="1"
                            data-val-range-max="999999">
                        <option value="">Select Airline</option>
                        @foreach (var airline in Model.Airlines ?? new List<Airline>())
                        {
                            if (Model.Flight?.AirlineId == airline.Id)
                            {
                                <option value="@airline.Id" selected="selected">@airline.Name</option>
                            }
                            else
                            {
                                <option value="@airline.Id">@airline.Name</option>
                            }
                        }
                    </select>
                    <span data-valmsg-for="AirlineId" data-valmsg-replace="true" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">From <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="From"
                                   placeholder="e.g., New York"
                                   value="@Model.Flight?.From"
                                   data-val="true"
                                   data-val-required="Departure city is required." />
                            <span data-valmsg-for="From" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">To <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="To"
                                   placeholder="e.g., Los Angeles"
                                   value="@Model.Flight?.To"
                                   data-val="true"
                                   data-val-required="Arrival city is required." />
                            <span data-valmsg-for="To" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="Date"
                                   value="@dateValue"
                                   min="@tomorrow"
                                   data-validate-date
                                   data-val="true"
                                   data-val-required="Date is required." />
                            <span data-valmsg-for="Date" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Cabin Type <span class="text-danger">*</span></label>
                            <select class="form-select" name="CabinType"
                                    data-val="true"
                                    data-val-required="Cabin Type is required.">
                                <option value="">Select Cabin Type</option>
                                @foreach (var cabin in Model.CabinTypes ?? new List<string>())
                                {
                                    if (Model.Flight?.CabinType == cabin)
                                    {
                                        <option value="@cabin" selected="selected">@cabin</option>
                                    }
                                    else
                                    {
                                        <option value="@cabin">@cabin</option>
                                    }
                                }
                            </select>
                            <span data-valmsg-for="CabinType" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Departure Time <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" name="DepartureTime"
                                   value="@Model.Flight?.DepartureTime"
                                   data-val="true"
                                   data-val-required="Departure time is required." />
                            <span data-valmsg-for="DepartureTime" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Arrival Time <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" name="ArrivalTime"
                                   value="@Model.Flight?.ArrivalTime"
                                   data-val="true"
                                   data-val-required="Arrival time is required." />
                            <span data-valmsg-for="ArrivalTime" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Aircraft Type <span class="text-danger">*</span></label>
                    <select class="form-select" name="AircraftType"
                            data-val="true"
                            data-val-required="Aircraft Type is required.">
                        <option value="">Select Aircraft Type</option>
                        @foreach (var aircraft in Model.AircraftTypes ?? new List<string>())
                        {
                            if (Model.Flight?.AircraftType == aircraft)
                            {
                                <option value="@aircraft" selected="selected">@aircraft</option>
                            }
                            else
                            {
                                <option value="@aircraft">@aircraft</option>
                            }
                        }
                    </select>
                    <span data-valmsg-for="AircraftType" data-valmsg-replace="true" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">CO2 Emission (kg) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="Emission"
                                   step="0.01" min="0" placeholder="e.g., 85.50"
                                   value="@Model.Flight?.Emission.ToString("0.00")"
                                   data-val="true"
                                   data-val-required="Emission is required."
                                   data-val-number="Emission must be a valid number."
                                   data-val-range="Emission must be 0 or greater."
                                   data-val-range-min="0"
                                   data-val-range-max="999999" />
                            <span data-valmsg-for="Emission" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Price (USD) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" name="Price"
                                       step="0.01" min="0" placeholder="e.g., 299.00"
                                       value="@Model.Flight?.Price.ToString("0.00")"
                                       data-val="true"
                                       data-val-required="Price is required."
                                       data-val-number="Price must be a valid number."
                                       data-val-range="Price must be 0 or greater."
                                       data-val-range-min="0"
                                       data-val-range-max="999999" />
                            </div>
                            <span data-valmsg-for="Price" data-valmsg-replace="true" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Update Flight
                    </button>
                    <a href="@Url.Action("Manage")" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                </div>

            </form>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-info-circle me-1"></i> Editing</h5>
                    <p class="small text-muted mb-0">
                        Flight <strong>@Model.Flight?.FlightCode</strong>
                        on @Model.Flight?.Date.ToShortDateString()
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")
    <script src="~/js/date-validation.js" asp-append-version="true"></script>
}
