@model GroupOneFlight.Models.ViewModels.FlightIndexViewModel;
@using GroupOneFlight.Models.ViewModels;
@using GroupOneFlight.Models.DomainModels;


@{
    ViewData["Title"] = "Flights";
}

<div class="container py-5">

    <h2 class="mb-4">Filter Flights</h2>

    <!-- PURE HTML FORM (NO TAG HELPERS) -->
    <form method="get" action="" class="row g-3">

        <!-- FROM CITY -->
        <div class="col-md-4">
            <label class="form-label">From</label>
            <select class="form-select" name="fromCity">
                <option value="">All</option>
                @foreach (var city in Model.FromCities)
                {
                    <option value="@city">@city</option>
                }
            </select>
        </div>

        <!-- TO CITY -->
        <div class="col-md-4">
            <label class="form-label">To</label>
            <select class="form-select" name="toCity">
                <option value="">All</option>
                @foreach (var city in Model.ToCities)
                {
                    <option value="@city">@city</option>
                }
            </select>
        </div>

        <!-- CABIN TYPE -->
        <div class="col-md-4">
            <label class="form-label">Cabin Type</label>
            <select class="form-select" name="cabinType">
                <option value="">All</option>
                @foreach (var cabin in Model.CabinTypes)
                {
                    <option value="@cabin">@cabin</option>
                }
            </select>
        </div>

        <!-- SUBMIT -->
        <div class="col-12">
            <button type="submit" class="btn btn-success mt-2">
                Apply Filters
            </button>
        </div>

    </form>

    <hr class="my-4" />

    <!-- FLIGHTS TABLE -->
    <h4 class="mb-3">Available Flights</h4>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Flight #</th>
                    <th>Airline</th>
                    <th>Route</th>
                    <th>Date & Time</th>
                    <th>Duration</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Flights != null && Model.Flights.Any())
                {
                    TimeSpan ParseTime(string? time)
                    {
                        if (string.IsNullOrEmpty(time)) return TimeSpan.Zero;
                        if (TimeSpan.TryParse(time, out var result)) return result;
                        return TimeSpan.Zero;
                    }

                    string CalculateDuration(string? depTime, string? arrTime)
                    {
                        var dep = ParseTime(depTime);
                        var arr = ParseTime(arrTime);
                        
                        if (dep == TimeSpan.Zero || arr == TimeSpan.Zero)
                            return "N/A";
                        
                        TimeSpan duration = arr > dep ? arr - dep : TimeSpan.FromHours(24) - dep + arr;
                        int hours = (int)duration.TotalHours;
                        int minutes = duration.Minutes;
                        return hours > 0 ? $"{hours}h {minutes}m" : $"{minutes}m";
                    }

                    foreach (var flight in Model.Flights)
                    {
                        var flightOption = Model.FlightOptions?.FirstOrDefault(fo => fo.FlightId == flight.Id);
                        decimal displayPrice = flightOption != null ? Model.MinPriceByFlightId.ContainsKey(flight.Id) ? Model.MinPriceByFlightId[flight.Id] : 0 : 0;

                        <tr>
                            <td>
                                <strong>@(flight.FlightCode ?? "N/A")</strong>
                            </td>
                            <td>
                                <i class="fas fa-plane-departure" style="color: #0d6efd; margin-right: 8px;"></i>
                                @(flight.Airline?.Name ?? "N/A")
                            </td>
                            <td>
                                @(flight.From ?? "N/A") <i class="fas fa-arrow-right" style="color: #6c757d; margin: 0 5px;"></i> @(flight.To ?? "N/A")
                            </td>
                            <td>
                                <div style="font-size: 0.9rem;">
                                    <div>@flight.Date.ToShortDateString()</div>
                                    <div style="color: #6c757d;">@(flight.DepartureTime ?? "N/A") — @(flight.ArrivalTime ?? "N/A")</div>
                                </div>
                            </td>
                            <td>
                                @CalculateDuration(flight.DepartureTime, flight.ArrivalTime)
                            </td>
                            <td>
                                @if (displayPrice > 0)
                                {
                                    <strong>From $@displayPrice.ToString("F2")</strong>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                <a href="#" class="btn btn-sm btn-outline-primary" title="View Flight Details">
                                    <i class="fas fa-eye"></i> Details
                                </a>
                                <a href="#" class="btn btn-sm btn-success" title="Select This Flight">
                                    <i class="fas fa-check"></i> Select
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fas fa-search" style="font-size: 2rem; margin-bottom: 10px; display: block;"></i>
                            No flights available. Try adjusting your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>