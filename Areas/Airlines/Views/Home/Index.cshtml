@model GroupOneFlight.Areas.Airlines.ViewModels.FlightViewModel

@{
    ViewData["Title"] = "Flights";
}

<div class="container py-5">

    <h2 class="mb-4">Filter Flights</h2>

    <!-- PURE HTML FORM (NO TAG HELPERS) -->
    <form method="get" action="" class="row g-3">

        <!-- FROM CITY -->
        <div class="col-md-4">
            <label class="form-label">From</label>
            <select class="form-select" name="fromCity">
                <option value="">All</option>
                @foreach (var city in Model.FromCities)
                {
                    <option value="@city">@city</option>
                }
            </select>
        </div>

        <!-- TO CITY -->
        <div class="col-md-4">
            <label class="form-label">To</label>
            <select class="form-select" name="toCity">
                <option value="">All</option>
                @foreach (var city in Model.ToCities)
                {
                    <option value="@city">@city</option>
                }
            </select>
        </div>

        <!-- CABIN TYPE -->
        <div class="col-md-4">
            <label class="form-label">Cabin Type</label>
            <select class="form-select" name="cabinType">
                <option value="">All</option>
                @foreach (var cabin in Model.CabinTypes)
                {
                    <option value="@cabin">@cabin</option>
                }
            </select>
        </div>

        <!-- SUBMIT -->
        <div class="col-12">
            <button type="submit" class="btn btn-success mt-2">
                Apply Filters
            </button>
        </div>

    </form>

    <hr class="my-4" />

    <!-- FLIGHTS TABLE -->
    <h4 class="mb-3">Flights</h4>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Flight #</th>
                <th>Airline</th>
                <th>From</th>
                <th>To</th>
                <th>Date</th>
                <th>Departure</th>
                <th>Arrival</th>
                <th>Cabin</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Flights != null && Model.Flights.Any())
            {
                foreach (var flight in Model.Flights)
                {
                    <tr>
                        <td>@(flight.FlightNumber ?? "N/A")</td>
                        <td>@(flight.Airline?.Name ?? "N/A")</td>
                        <td>@(flight.From ?? "N/A")</td>
                        <td>@(flight.To ?? "N/A")</td>
                        <td>@flight.Date.ToShortDateString()</td>
                        <td>@(flight.DepartureTime ?? "N/A")</td>
                        <td>@(flight.ArrivalTime ?? "N/A")</td>
                        <td>@(flight.CabinType ?? "N/A")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">
                        No flights available.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>