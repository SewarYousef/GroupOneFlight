@* Areas/Airlines/Views/Shared/_AirlineLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GroupOneFlight Airline</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <style>
        .navbar-nav .nav-link.active {
            color: #0d6efd !important;
            font-weight: bold;
            border-bottom: 2px solid #0d6efd;
        }
    </style>
</head>

<body>

<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">

            <!-- BRAND -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#airlineNavbar"
                    aria-controls="airlineNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="navbar-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                GroupOneFlight Airline
            </a>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between"
                 id="airlineNavbar">

                <!-- LEFT NAV -->
                <ul class="navbar-nav flex-grow-1">

                    <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["controller"]?.ToString() == "Flights" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           asp-area="Airlines"
                           asp-controller="Flights"
                           asp-action="Index">
                            Flights
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" ? "active" : "")"
                           asp-area="Admin"
                           asp-controller="Users"
                           asp-action="Index">
                            Admin
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="pb-3">
    <div class="container-fluid">
        @RenderBody()
    </div>
</main>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        &copy; 2026 - GroupOneFlight Airline Services
    </div>
</footer>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>