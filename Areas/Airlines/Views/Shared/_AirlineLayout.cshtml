<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GroupOneFlight Airline</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <style>
        .navbar-nav .nav-link { transition: all 0.3s ease; }
        .navbar-nav .nav-link.active {
            color: #0d6efd !important;
            font-weight: bold;
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 0.5rem;
        }
        .navbar-nav .nav-link:hover { color: #0056b3 !important; }
    </style>
</head>
<body>

<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#airlineNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-plane-departure"></i> GroupOneFlight Airline
            </a>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="airlineNavbar">

                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["controller"]?.ToString() == "Flights" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           asp-area="Airlines" asp-controller="Flights" asp-action="Index">
                            <i class="fas fa-list"></i> Flights
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["controller"]?.ToString() == "Flights" && ViewContext.RouteData.Values["action"]?.ToString() == "Manage" ? "active" : "")"
                           asp-area="Airlines" asp-controller="Flights" asp-action="Manage">
                            <i class="fas fa-cog"></i> Manage
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["controller"]?.ToString() == "Flights" && ViewContext.RouteData.Values["action"]?.ToString() == "Regulation" ? "active" : "")"
                           asp-area="Airlines" asp-controller="Flights" asp-action="Regulation">
                            <i class="fas fa-book"></i> Regulations
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home"></i> Home
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>
</header>

<main role="main" class="pb-3">
    <div class="container-fluid">
        @await Html.PartialAsync("~/Views/Shared/_TempDataConfirmation.cshtml")
        @RenderBody()
    </div>
</main>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        &copy; 2026 - GroupOneFlight Airline Services
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
