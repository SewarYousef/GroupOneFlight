@* Areas/Admin/Views/Shared/_AdminLayout.cshtml *@
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- Admin Navbar -->
<nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom shadow-sm">
    <div class="container-fluid">

        <a class="navbar-brand"
           asp-area="Admin"
           asp-controller="Users"
           asp-action="Index">
            GroupOneFlight - Admin
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#adminNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">

            <ul class="navbar-nav me-auto">

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Manage">
                        Manage
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Rights">
                        Rights & Obligations
                    </a>
                </li>

            </ul>

            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        View Site
                    </a>
                </li>
            </ul>

        </div>
    </div>
</nav>

<div class="container mt-4">
    @RenderBody()
</div>

<footer class="border-top footer text-muted mt-5 text-center">
    <div class="container">
        <p>&copy; 2026 - GroupOneFlight Admin Portal</p>
    </div>
</footer>