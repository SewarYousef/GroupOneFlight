@* Areas/Admin/Views/Shared/_AdminLayout.cshtml *@
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- Admin Navbar -->
<nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom shadow-sm">
    <div class="container-fluid">

        <a class="navbar-brand"
           asp-area="Admin"
           asp-controller="Users"
           asp-action="Index">
            <i class="fas fa-shield-alt"></i> GroupOneFlight - Admin
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#adminNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">

            <ul class="navbar-nav me-auto">

                <!-- Dashboard -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index">
                        <i class="fas fa-chart-line"></i> Dashboard
                    </a>
                </li>

                <!-- Manage Users -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" && ViewContext.RouteData.Values["action"]?.ToString() == "Manage" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Manage">
                        <i class="fas fa-users"></i> Manage Users
                    </a>
                </li>

                <!-- Rights & Obligations -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" && ViewContext.RouteData.Values["action"]?.ToString() == "Rights" ? "active" : "")"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Rights">
                        <i class="fas fa-book"></i> Rights & Obligations
                    </a>
                </li>

            </ul>

            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        <i class="fas fa-home"></i> View Site
                    </a>
                </li>
            </ul>

        </div>
    </div>
</nav>

<style>
    .navbar-nav .nav-link {
        transition: all 0.3s ease;
        margin-right: 0.5rem;
    }

    .navbar-nav .nav-link.active {
        color: #0d6efd !important;
        font-weight: bold;
        border-bottom: 2px solid #0d6efd;
        padding-bottom: 0.25rem;
    }

    .navbar-nav .nav-link:hover {
        color: #0056b3 !important;
    }
</style>

<div class="container mt-4">
    @RenderBody()
</div>

<footer class="border-top footer text-muted mt-5 text-center">
    <div class="container">
        <p>&copy; 2026 - GroupOneFlight Admin Portal</p>
    </div>
</footer>